{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "base-frontend": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/base-frontend",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets",
                "src/firebase-messaging-sw.js",
                "src/manifest.webmanifest"
            ],
            "styles": [
                "node_modules/shepherd.js/dist/css/shepherd.css",
              "@angular/material/prebuilt-themes/azure-blue.css",
              "src/assets/vendor/bootstrap/css/bootstrap.min.css",
              "src/assets/vendor/boxicons/css/boxicons.min.css",
              "src/assets/vendor/quill/quill.snow.css",
              "src/assets/vendor/quill/quill.bubble.css",
              "src/assets/vendor/remixicon/remixicon.css",
              "src/assets/vendor/simple-datatables/style.css",
              "node_modules/@fortawesome/fontawesome-free/css/all.min.css",
              "src/assets/css/list.css",
              "src/assets/css/forms.css",
              "src/assets/css/filter.css",
              "src/assets/css/planShowCounts.css",
              "src/styles.css",
              "src/styles.scss",
              "src/assets/css/admin&subAdmin.css",
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "node_modules/bootstrap-icons/font/bootstrap-icons.css",
              "node_modules/datatables.net-dt/css/dataTables.dataTables.min.css",
              "node_modules/ngx-bootstrap/datepicker/bs-datepicker.css",
              "node_modules/ngx-toastr/toastr.css",
              "./node_modules/@ng-select/ng-select/themes/default.theme.css"
            ],
            "stylePreprocessorOptions": {
        "includePaths": [
          "src"
        ]
      },
            "scripts": [
              "node_modules/jquery/dist/jquery.min.js"
            ]
          },
          "configurations": {
           "production": {
 "budgets": [
  {
    "type": "initial",
    "maximumWarning": "5MB",
    "maximumError": "6MB"
  },
  {
    "type": "anyComponentStyle",
    "maximumWarning": "30kB",
    "maximumError": "50kB"
  }
],
  "optimization": {
    "scripts": true,
    "styles": {
      "minify": true,
      "inlineCritical": true
    },
    "fonts": {
      "inline": false
    }
  },
  "outputHashing": "all",
  "serviceWorker": "ngsw-config.json"
},
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "base-frontend:build:production"
            },
            "development": {
              "buildTarget": "base-frontend:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets"
              }
            ],
            "styles": [
              "@angular/material/prebuilt-themes/azure-blue.css",
              "src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
